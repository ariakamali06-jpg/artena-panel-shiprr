# =============================================================================
# Kestrel Control — Environment Configuration
# See ENVIRONMENT_CONFIGURATION_GUIDE.md for detailed setup instructions.
# =============================================================================

# --- Server Runtime ---
# HTTP server listening port (Railway injects PORT automatically; local dev uses 3000)
PORT=3000

# Persistent data directory (on Railway, mount a Volume and set RAILWAY_VOLUME_MOUNT_PATH)
DATA_DIR=./data
RAILWAY_VOLUME_MOUNT_PATH=

# --- Administrator Authentication ---
# Optional owner username (if ADMIN_PASSWORD is empty, use the secure First-Run Setup screen)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Session Signing Secret (leave empty during initial setup; set before production) ---
# Used to HMAC-SHA256 sign session tokens. If empty, an ephemeral in-memory secret is used.
SESSION_SECRET=

# --- Public HTTP/HTTPS Networking (deployment-dependent) ---
# Public HTTPS origin of this panel (used for subscription links, Telegram Bot, and Mini App)
PUBLIC_BASE_URL=

# --- Raw VLESS-TCP Relay Networking (network-dependent; optional if only using WS/XHTTP) ---
# Local TCP port that the VLESS-TCP server binds to inside the container/host
TCP_LISTEN_PORT=

# External hostname/IP that clients connect to for VLESS-TCP (e.g., Railway TCP Proxy host or VPS domain)
TCP_PUBLIC_HOST=

# External public TCP port mapped to TCP_LISTEN_PORT (e.g., Railway TCP Proxy assigned port)
TCP_PUBLIC_PORT=

# --- Telegram Bot & Mini App Integration (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_BOT_USERNAME=

# --- Automated Sales Provisioning Defaults (sales-dependent) ---
# Accepted values: vless-ws, vless-tcp, xhttp-packet-up, xhttp-stream-up, xhttp-stream-one, vmess-ws, trojan-ws
SALES_DEFAULT_PROTOCOL=

# Public client port assigned to auto-provisioned sales services (integer 1-65535)
SALES_DEFAULT_PORT=
